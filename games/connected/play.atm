;; Play: a grid of 6 x 6 dots of four colors, each dot a task.

pin IMG_BAR      = eng.image(A ++ "images/bar.png")
pin IMG_PROGRESS = eng.image(A ++ "images/progress.png")
pin IMG_TUTO     = eng.image(A ++ "images/tuto.png")
pin IMG_QUESTION = eng.image(A ++ "images/question.png")
val SND_TAP2 = eng.sound(A ++ "sounds/tap2.wav")
val SND_TAP3 = eng.sound(A ++ "sounds/tap3.wav")
val TILE = 60

;; rand(num) of the original
func rand (n) {
    eng.rand(n)
}

;; the dots that grow, are removed, or fall, and the bar
task Tween (o, to, ms, delay) {
    await Motion(o, to, ms, nil, delay)
}

task Play () {
    pin phys = Physics_screen()         ;; the bodies of the screen (Physics)
    set :out Physics.scr = phys
    input_reset()
    pin dots = tasks(70)                ;; as many as the group of the original
    pin label_score = Text(40, 20, "0", 20)
    pin label_moves = Text(W - 75, 20, "0/20", 20)
    loop _, t in [label_score, label_moves] {
        set t.color = INK
    }
    pin progress = Sprite(IMG_PROGRESS, W/2, H - 50)
    set progress.ax, progress.ay = (0, 0.5)
    pin bar = Sprite(IMG_BAR, W/2, H - 50)
    set bar.ax, bar.ay = (0.5, 0.5)
    prop_set(progress, "width", 0)
    set progress.x -= IMG_BAR.fw / 2
    pin question = Sprite(IMG_QUESTION, W/2, 30)
    set question.ax, question.ay = (0.5, 0.5)
    var tuto = nil
    pin tweens = tasks()

    var count, moves, type = (0, 0, -1)
    pin deleted = []
    var pos_i, pos_j = (-1, -1)
    val offset_x = ((W - (6 * TILE)) / 2) + (TILE / 2)
    val offset_y = 80
    set score = 0

    ;; [trace]
    pin trace_q = [ dots=dots, progress=progress,
                 moves=\{ moves }, count=\{ count }, type=\{ type } ]
    set :out Trace.q = trace_q              ;; Tracer reads it while the screen lasts
    ;; [/trace]

    spawn {
        loop on :draw {
            ray.clear(BG)
            loop _, t in dots {
                if t.pub.s.visible {
                    sprite_draw(t.pub.s)
                }
            }
            text_draw(label_score)
            text_draw(label_moves)
            sprite_draw(progress)
            sprite_draw(bar)
            sprite_draw(question)
            if tuto && tuto.visible {
                sprite_draw(tuto)
            }
        }
    }

    ;; the question: a picture over the game, until clicked
    spawn {
        loop {
            await Button(question)
            set tuto = Sprite(IMG_TUTO, 0, 0)
            await Button(tuto)
            set tuto.visible = false
        }
    }

    val func width_bar () { prop_get(progress, "width") / 28 }

    ;; a dot: it grows in, may be selected, falls, and when it is removed
    ;; grows to 2 and fades, and dies (the update below kills it). Its
    ;; tweens are in its own pool. pub: its sprite and body, and the pool.
    val task Dot (i, j, first) {
        val b = Body(Sprite(IMG_DOT, 0, 0), :dot)
        val d = b.spr
        pin tw = tasks()
        set pub = [ s=d, b=b ]
        set :out pub.tw = tw
        defer {
            body_remove(b)
        }
        set d.frame = rand(4) * 2
        set d.ax, d.ay = (0.5, 0.5)
        set d.selected = false
        set d.pos_i, d.pos_j = (i, j)
        set d.move_y = 0
        body_set_size(b, 30, 30, 0, 0)
        set d.alpha = 1
        set d.sx, d.sy = (0.01, 0.01)
        set d.alive2 = true
        sprite_reset(d, b, offset_x + (j * TILE), offset_y + (i * TILE))
        spawn @tw Tween(d, [sx=1, sy=1], 400, if first => (j * 100) + 1 => 400)
        await :update until !d.alive
    }

    val func clear_bar () {
        spawn @tweens Tween(progress, [width=0], 300)
    }

    val func unselect_all () {
        set count = 0
        loop _, t in dots {
            val e = t.pub.s
            if e.alive && e.selected {
                set e.selected = false
                set e.frame -= 1
            }
        }
        clear_bar()
    }

    val func in_range (d) {
        if pos_j == -1 {
            return true
        }
        ((pos_j - 1) == d.pos_j && (pos_i == d.pos_i)) ||
        (((pos_j + 1) == d.pos_j) && (pos_i == d.pos_i)) ||
        ((pos_j == d.pos_j) && ((pos_i - 1) == d.pos_i)) ||
        ((pos_j == d.pos_j) && ((pos_i + 1) == d.pos_i))
    }

    val func select (d) {
        if sound {
            ifs {
                width_bar() <= 3 => eng.play(SND_TAP1, 0.5)
                width_bar() <= 7 => eng.play(SND_TAP2, 0.7)
                else => eng.play(SND_TAP3, 0.9)
            }
        }
        set d.selected = true
        set d.frame += 1
        set count += 1
        set pos_j, pos_i = (d.pos_j, d.pos_i)
        if width_bar() <= 11 {
            spawn @tweens Tween(progress, [width="+28"], 100)
        }
    }

    ;; try_select_a_dot: the dots under the pointer, in the order of the group
    val func try_select () {
        val px, py = (pointer_x(), pointer_y())
        loop _, t in dots {
            val e = t.pub.s
            if e.alive && !e.selected && contains(t.pub.b, px, py) {
                if type == -1 {
                    set type = e.frame
                }
                if (type == e.frame) && in_range(e) {
                    select(e)
                } else {
                    unselect_all()
                }
            }
        }
    }

    val func remove_selected () {
        loop _, t in dots {
            val e = t.pub.s
            if e.alive && e.selected {
                spawn @(t.pub.tw) Tween(e, [sx=2, sy=2], 300)
                spawn @(t.pub.tw) Tween(e, [alpha=0], 300)
                set deleted@+ = [i=e.pos_i, j=e.pos_j]
                set e.alive2 = false
            }
        }
    }

    val func move_down () {
        loop _, del in deleted {
            loop _, t in dots {
                val e = t.pub.s
                if e.alive && !e.selected && (e.pos_j == del.j) && (e.pos_i < del.i) {
                    set e.move_y += TILE
                }
            }
        }
        loop _, t in dots {
            val e = t.pub.s
            if e.alive && (e.move_y != 0) {
                val coef = e.move_y / TILE
                set e.pos_i += coef
                spawn @(t.pub.tw) Tween(e, [y=e.y + e.move_y], 100 * coef, 100)
                set e.move_y = 0
            }
        }
        vector.clear(deleted)
    }

    val func add_missing () {
        pin min = [6, 6, 6, 6, 6, 6]
        loop _, t in dots {
            val e = t.pub.s
            if e.alive && (e.pos_i < min@(e.pos_j)) && e.alive2 {
                set min@(e.pos_j) = e.pos_i
            }
        }
        loop i in 6 {
            loop j in min@(i) {
                spawn @dots Dot(j, i, false)
            }
        }
    }

    val func multiplier () {
        ifs {
            width_bar() <= 4 => 1
            width_bar() <= 8 => 5
            else => 10
        }
    }

    ;; build_world
    loop i in 6 {
        loop j in 6 {
            spawn @dots Dot(i, j, true)
        }
    }

    ;; the dots grown to 2 die, first in each update
    spawn {
        loop on :update {
            loop _, t in dots {
                if t.pub.s.alive && (t.pub.s.sx == 2) {
                    sprite_kill(t.pub.s)
                }
            }
        }
    }

    ;; a move: the button goes down (300 ms after the last move), the dots
    ;; under the pointer are selected while it stays down, and the move
    ;; ends when it goes up; the flags clicked and next_time of the original
    ;; are this sequence
    await :update until pointer_down()
    loop {
        try_select()                        ;; in the update of the press
        loop on :update {
            until !pointer_down()
            try_select()
        }
        ;; in the update of the release
        if count > 1 {
            remove_selected()
            move_down()
            add_missing()
            ;; update_score_and_labels
            if sound { eng.play(SND_COMBO, 0.4) }
            set moves += 1
            set label_moves.s = tostring(moves) ++ "/20"
            set score += count * multiplier()
            set label_score.s = tostring(score)
            clear_bar()
        } else {
            unselect_all()
        }
        until moves == 20
        set count, type = (0, -1)
        set pos_i, pos_j = (-1, -1)
        await Wait(300)                     ;; next_time: now > the release + 300
        if !pointer_down() {
            await :update until pointer_down()
        }
    }
}

;; [trace]
;; the line of the trace: as tools/original/trace/7.js
func trace (p) {
    val f = ray.frame()
    if screen != "Play" {
        return tostring(f) ++ " " ++ screen ++ " " ++ tostring(score)
    }
    var n, fr, sy, sc = (0, 0, 0, 0)
    loop _, t in p.dots {
        val e = t.pub.s
        if e.alive {
            set n += 1
            set fr += e.frame
            set sy += e.y
            set sc += math.floor((e.sx * 1000) + 0.5)    ;; as trace/7.js
        }
    }
    tostring(f) ++ " Play " ++ tostring(score) ++ " " ++ tostring(p.moves()) ++ " " ++
        tostring(p.count()) ++ " " ++ tostring(p.type()) ++ " " ++
        eng.fixed(prop_get(p.progress, "width"), 2) ++ " " ++ tostring(n) ++ " " ++
        tostring(fr) ++ " " ++ eng.fixed(sy, 2) ++ " " ++ eng.fixed(sc / 1000, 3)
}
;; [/trace]
