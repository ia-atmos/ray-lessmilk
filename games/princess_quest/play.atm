;; Play: the platforms, hearts, spikes, and clouds, from groups recycled;
;; the screen goes up with the princess.

pin IMG_HEART  = eng.image(A ++ "images/heart.png")
pin IMG_SPIKE  = eng.image(A ++ "images/spike.png")
pin IMG_CLOUD  = eng.image(A ++ "images/cloud.png")
pin IMG_GROUND = eng.image(A ++ "images/ground.png")
val SND_HEART = eng.sound(A ++ "sounds/heart.wav")
val SND_MUSIC = eng.sound(A ++ "sounds/music.wav")
val SND_HIT   = eng.sound(A ++ "sounds/hit.wav")

;; rand(num) of the original
func rand (n) {
    eng.rand(n)
}

;; the kinds of the next platform, by score
func level_of (s) {
    ifs {
        s < 250  => [1, 1, 1, 1, 2, 2, 2, 3, 5, 5]
        s < 500  => [1, 1, 2, 2, 2, 3, 3, 4, 4, 5]
        s < 1000 => [1, 2, 2, 3, 3, 3, 4, 4, 4, 5]
        s < 2000 => [1, 2, 3, 3, 3, 4, 4, 4, 4, 5]
        s < 3000 => [2, 3, 3, 3, 4, 4, 4, 4, 4, 5]
        else     => [2, 3, 3, 4, 4, 4, 4, 4, 4, 4]
    }
}

task Play () {
    pin phys = Physics_screen()         ;; the bodies of the screen (Physics)
    set :out Physics.scr = phys
    input_reset()
    set Physics.x, Physics.y, Physics.w, Physics.h = (0, -100000, W, H + 100000)   ;; world.setBounds
    pin keys = Cursor()
    pin clouds = Group(IMG_CLOUD, 6, :cloud)
    loop _, x in clouds.slots {
        set x.s.oob_kill = true
    }
    if score > best_score {
        set best_score = score
    }
    set score = 0
    pin platforms = Group(IMG_PLATFORM, 15, :platform)
    loop _, x in platforms.slots {
        set x.b.immovable = true
        set x.b.allow.down, x.b.allow.right, x.b.allow.left = (false, false, false)
    }
    pin hearts = Group(IMG_HEART, 3, :heart)
    pin spikes = Group(IMG_SPIKE, 5, :spike)
    pin emitter = Emitter(IMG_HEART, 100)
    set emitter.x = -100
    set emitter.on = false
    set emitter.gravity = 10
    emitter_start(emitter, false, 1000, 15, 0)
    set emitter.w = 50
    spawn Emitter_run(emitter)
    val pb = Body(Sprite(IMG_PRINCESS, (W/2) + 100, H - 200), :princess)
    val princess = pb.spr
    set pb.gy = 12
    set princess.ax, princess.ay = (0.5, 1)
    set princess.alive = true
    val gb = Body(do {
        val ground = Sprite(IMG_GROUND, 0, H - 56)
        set ground.sx, ground.sy = (15, 1)
        ground
    }, :ground)
    val ground = gb.spr
    set gb.immovable = true
    set ground.alive = true
    set ground.oob_kill = true
    pin score_label = Text(10, 10, "0", 20)
    eng.play(SND_MUSIC, 0.2)
    var next_platform, next_cloud = (10, 50)
    var took_heart = false
    var count_update = 0
    pin tweens = tasks()

    ;; [trace]
    pin trace_q = [ princess=princess, pb=pb, platforms=platforms, hearts=hearts,
                spikes=spikes, clouds=clouds, emitter=emitter,
                next=\{ next_platform }, took=\{ took_heart } ]
    set :out Trace.q = trace_q              ;; Tracer reads it while the screen lasts
    ;; [/trace]

    spawn {
        loop on :draw {
            ray.clear(BG)
            group_draw(clouds)
            group_draw(platforms)
            group_draw(hearts)
            group_draw(spikes)
            emitter_draw(emitter)
            sprite_draw(princess)
            if ground.visible != false {
                sprite_draw(ground)
            }
            text_draw(score_label)
        }
    }

    val func add_platform (y, x) {
        val p = group_first_dead(platforms)
        if p {
            val pw = IMG_PLATFORM.fw * p.s.sx
            val px = if x == nil => (rand((W - pw) - 10) + (pw / 2)) + 5 => x
            sprite_reset(p.s, p.b, px, y)
            set p.s.ax, p.s.ay = (0.5, 0.5)
            set p.b.vx = 0
        }
        p
    }
    val func add_spike (x, y) {
        val sp = group_first_dead(spikes)
        if sp {
            body_set_size(sp.b, (IMG_SPIKE.fw * sp.s.sx) - 6, (IMG_SPIKE.fh * sp.s.sy) - 6, 0, 0)
            set sp.s.ax, sp.s.ay = (0.5, 0.5)
            sprite_reset(sp.s, sp.b, x, y)
        }
    }
    val func add_cloud (y) {
        val c = group_first_dead(clouds)
        if c {
            sprite_reset(c.s, c.b, rand(W) - (IMG_CLOUD.fw * c.s.sx), y)
            set c.b.vx = if rand(2) == 1 => 8 => -8
        }
    }
    val func add_moving (y) {
        val p = add_platform(y)
        set p.b.vx = if rand(2) == 0 => -120 => 120
    }
    val func add_double (y) {
        add_platform(y)
        add_platform(y)
    }

    ;; init_level
    add_platform(H - 150, 100)
    add_platform(H - 300, 200)
    add_platform(H - 450, 300)
    add_platform(H - 550, 300)
    add_cloud(H - 300)
    add_cloud(H - 500)

    val func generate_level () {
        if next_platform < -Camera.y {
            pin lv = level_of(score)
            val kind = lv@(rand(#lv))
            val y = Camera.y - 30
            set next_platform += rand(80) + 70
            ifs {
                kind == 1 => add_double(y)
                kind == 2 => add_platform(y)
                kind == 3 => add_moving(y)
                kind == 4 => {
                    if rand(3) > 0 {
                        add_moving(y)
                    } else {
                        add_double(y)
                    }
                    ;; add_platform_spike
                    val p = add_platform(y - 150)
                    add_spike(p.s.x, p.s.y + 18)
                    set next_platform += 150
                }
                kind == 5 => {
                    ;; add_platform_heart
                    val p = add_platform(y)
                    val hh = group_first_dead(hearts)
                    if hh {
                        set hh.s.ax, hh.s.ay = (0.5, 0.5)
                        sprite_reset(hh.s, hh.b, p.s.x, y - 29)
                    }
                }
            }
        }
        if next_cloud < -Camera.y {
            add_cloud(Camera.y - 70)
            set next_cloud += 100 + rand(200)
        }
    }

    loop on :update {
        if princess.alive {
            if ground.alive {
                collide(pb, gb)
            }
            collide_group(pb, :platform)
            loop _, hb in overlap_list(pb, :heart) {
                ;; take_heart
                sprite_kill(hb.spr)
                if sound { eng.play(SND_HEART, 0.2) }
                set emitter.on = true
                set pb.vy = -1200
                set took_heart = true
            }
            loop _, sb in overlap_list(pb, :spike) {
                ;; take_spike
                if !took_heart {
                    if sound { eng.play(SND_HIT, 0.4) }
                    set princess.alive = false
                    set pb.vy = -300
                }
            }
        }
        if pb.y < (Camera.y + (H/2)) {
            ;; move_screen_up
            val delta = (Camera.y + math.floor(H/2)) - pb.y
            camera_set("y", Camera.y - delta)
            set score_label.y = Camera.y + 10
            set score = -math.floor(Camera.y / 10)
            set score_label.s = tostring(score)
            generate_level()
        }
        if count_update == 20 {
            set count_update = 0
            loop _, x in platforms.slots {
                val p = x.s
                if p.alive {
                    val pw, ph = (IMG_PLATFORM.fw * p.sx, IMG_PLATFORM.fh * p.sy)
                    ifs {
                        ((p.x + (pw / 2)) >= W) && (x.b.vx > 0) => set x.b.vx = -120
                        ((p.x - (pw / 2)) <= 0) && (x.b.vx < 0) => set x.b.vx = 120
                    }
                    if (p.y - ph) > (Camera.y + H) {
                        sprite_kill(p)
                    }
                }
            }
            ;; update_heart: its parameter `h` hides the height, and the test
            ;; compares a number with a string: no heart is ever killed
            loop _, x in spikes.slots {
                val sp = x.s
                if sp.alive && ((sp.y - (IMG_SPIKE.fh * sp.sy)) > (Camera.y + H)) {
                    sprite_kill(sp)
                }
            }
        } else {
            set count_update += 1
        }
        ;; princess_move
        until pb.y > ((Camera.y + H) + 200)
        ifs {
            princess.x < 20 => set princess.x = 20
            princess.x > (W - 20) => set princess.x = W - 20
        }
        if pb.touching.down && (princess.sy == 1) {
            if sound { eng.play(SND_JUMP, 0.15) }
            spawn @tweens Squash(princess, pb, if princess.sx == 1 => 1.3 => -1.3, true)
        }
        set pb.vx = 0
        val touch_right = pointer_down() && (ray.mouse_x() > (W/2))
        val touch_left  = pointer_down() && (ray.mouse_x() < (W/2))
        ifs {
            (cursor_down(keys, 'LEFT') || touch_left) && princess.alive => {
                set princess.frame = 0
                set pb.vx = -300
                if princess.sx == 1 {
                    set princess.sx, princess.sy = (-1, 1)
                }
            }
            (cursor_down(keys, 'RIGHT') || touch_right) && princess.alive => {
                set princess.frame = 0
                set pb.vx = 300
                if princess.sx == -1 {
                    set princess.sx, princess.sy = (1, 1)
                }
            }
            else => set princess.frame = 1
        }
        if pb.vy > -200 {
            set took_heart = false
            set emitter.on = false
        }
        set emitter.x = princess.x
        set emitter.y = princess.y - 15
    }
}

;; [trace]
;; the line of the trace: as tools/original/trace/6.js
func trace (p) {
    val f = ray.frame()
    var r = tostring(f) ++ " " ++ screen ++ " " ++ tostring(score) ++ " " ++ tostring(best_score)
    if screen == "Play" {
        val pr = p.princess
        var n, sx, sy = (0, 0, 0)
        loop _, x in p.platforms.slots {
            if x.s.exists {
                set n += 1
                set sx += x.s.x
                set sy += x.s.y
            }
        }
        set r = r ++ " " ++ eng.fixed(pr.x, 2) ++ " " ++ eng.fixed(pr.y, 2) ++ " " ++
            eng.fixed(p.pb.vx, 2) ++ " " ++ eng.fixed(p.pb.vy, 2) ++ " " ++
            (if pr.alive => "1" => "0") ++ " " ++ eng.fixed(pr.sx, 3) ++ " " ++ eng.fixed(pr.sy, 3) ++ " " ++
            tostring(pr.frame) ++ " " ++ eng.tostring(Camera.y) ++ " " ++ tostring(n) ++ " " ++
            eng.fixed(sx, 2) ++ " " ++ eng.fixed(sy, 2) ++ " " ++ tostring(#group_living(p.hearts)) ++ " " ++
            tostring(#group_living(p.spikes)) ++ " " ++ tostring(#group_living(p.clouds)) ++ " " ++
            tostring(#p.emitter.sprites) ++ " " ++ (if p.emitter.on => "1" => "0") ++ " " ++
            eng.tostring(p.next()) ++ " " ++ (if p.took() => "1" => "0")
    }
    r
}
;; [/trace]
