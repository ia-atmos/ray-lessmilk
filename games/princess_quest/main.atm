;; Princess Quest (lessmilk.com, game #6, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 1.1.3) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, princess_quest).
;;
;; The princess jumps by herself from platform to platform; the arrows move
;; her; the screen goes up with her; a heart throws her high; a spike, or a
;; fall, ends the game.

include "../../lib/game.atm"

val W, H = (450, 600)
val BG = 0xA3B9FFFF
val A = "assets/6/"

var score, best_score = (0, 0)      ;; the globals of the original
var sound = true

;; [trace]
var screen = "Menu"
;; [/trace]

rl.window [title="Princess Quest", width=W, height=H]

include "menu.atm"
include "play.atm"
include "dead.atm"

spawn Game(W, H)

;; [trace]
spawn Tracer(trace)
;; [/trace]

await Menu()
loop {
    ;; [trace]
    set screen = "Play"
    ;; [/trace]
    await Play()
    ;; [trace]
    set screen = "Dead"
    ;; [/trace]
    await Dead()
}
