;; Menu: the title falls, UP starts.

pin IMG_MENU  = eng.image(A ++ "images/menu.png")
pin IMG_SOUND = eng.image(A ++ "images/sound.png", 28, 22)

;; a button: pressed and released over it (the box of its frame)
func over (s, x, y) {
    val w, h = (s.img.fw * s.sx, s.img.fh * s.sy)
    val l, t = (s.x - (s.ax * w), s.y - (s.ay * h))
    (x >= l) && (x <= (l + w)) && (y >= t) && (y <= (t + h))
}
task Button (s) {
    loop {
        val d = await :rl.mouse.dn
        if over(s, d.x, d.y) {
            val u = await :rl.mouse.up
            until over(s, u.x, u.y)
        }
    }
}

;; a text that goes up and down, for ever: .to(a).to(b).loop()
task Swing (t, a, b) {
    loop {
        await Motion(t, [y=a], 500)
        await Motion(t, [y=b], 500)
    }
}

task Menu () {
    input_reset()
    pin logo = Sprite(IMG_MENU, W/2, -150)
    set logo.ax, logo.ay = (0.5, 0.5)
    spawn Motion(logo, [y=(H/2) - 20], 1000, Ease.bounce_out)
    pin start = Text(W/2, H - 60, "press the UP arrow key to start", 25)
    set start.ax, start.ay = (0.5, 0.5)
    set start.alpha = 0
    spawn Motion(start, [alpha=1], 500, nil, 500)
    spawn Swing(start, H - 70, H - 50)
    pin snd_btn = Sprite(IMG_SOUND, W - 50, 50)
    set snd_btn.ax, snd_btn.ay = (1, 0)
    set snd_btn.alpha = 0
    spawn Motion(snd_btn, [alpha=1], 500, nil, 500)
    spawn {
        loop {
            await Button(snd_btn)
            set snd_btn.frame = if snd_btn.frame == 0 => 1 => 0
            set sound = snd_btn.frame == 0
        }
    }
    spawn {
        loop on :rl.draw {
            rl.clear(BG)
            sprite_draw(logo)
            text_draw(start)
            sprite_draw(snd_btn)
        }
    }
    await :update until key_down('UP')
    await :state                    ;; state.start('Play'), in the next frame
}
