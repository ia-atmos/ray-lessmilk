;; The Three Hearts (lessmilk.com, game #11, 2014), by Thomas Palef.
;; Ported to Atmos from the original (Phaser 2.0.1) and from the port of
;; Jessica Oliveira (jessicacoliveira/atmos-lessmilk, the_three_hearts).
;;
;; A maze of rooms, seen one at a time: keys open doors, enemies go back
;; and forth, and three hearts end the game. The map is assets/11/levels/
;; map.json, as Atmos data (map.atm, tools/map11.py).

include "../../lib/game.atm"

val W, H = (480, 400)
val BG = 0xA9A9A9FF
val A = "assets/11/"

var sound = true            ;; the global of the original

;; [trace]
var screen = "Menu"
;; [/trace]

rl.window [title="The Three Hearts", width=W, height=H]

include "map.atm"
include "menu.atm"
include "play.atm"

spawn Game(W, H, 2)

;; [trace]
spawn Tracer(trace)
;; [/trace]

await Menu()
;; [trace]
set screen = "Play"
;; [/trace]
await Play()
