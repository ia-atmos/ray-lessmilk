;; Play: the bad one turns around the circle; a level of rabbits each turn.

pin IMG_RABBIT = eng.image(A ++ "images/rabbit2.png")
val SND_MUSIC = eng.sound(A ++ "sounds/music.wav")
val SND_HAHO  = eng.sound(A ++ "sounds/haho.mp3")
pin SND_VOWELS = [
    eng.sound(A ++ "sounds/a.mp3"), eng.sound(A ++ "sounds/e.mp3"),
    eng.sound(A ++ "sounds/i.mp3"), eng.sound(A ++ "sounds/o.mp3"),
    eng.sound(A ++ "sounds/u.mp3"),
]

;; a rabbit: it comes to the circle (its tween running until it is there),
;; may jump over the bad one and come back, fades when its level ends, and
;; lives until it dies (the bad one hits it, or it has faded). Its tweens are
;; in its own pool, so they end with it. pub: the sprite, and the pool.
task Rabbit (angle, i, cw) {
    val b = Body(Sprite(IMG_RABBIT, 0, 0), :rabbit)
    val r = b.spr
    pin tw = tasks()
    set pub = [ s=r ]
    set :out pub.tw = tw                ;; pub refers to the pool of the rabbit
    defer {
        body_remove(b)
    }
    set r.rot = angle + (math.pi / 2)
    set r.jump, r.pos = (false, i)
    sprite_reset(r, b, (W/2) + ((cw + 100) * math.cos(angle)), (H/2) + ((cw + 100) * math.sin(angle)))
    set r.ax, r.ay = (0.5, 1)
    spawn @tw Enter(r, (W/2) + (((cw / 2) - 2) * math.cos(angle)),
                       (H/2) + (((cw / 2) - 2) * math.sin(angle)))
    await :update until !r.alive
}

;; a rabbit comes to the circle: its tween is running until it is there
task Enter (r, x, y) {
    set r.entering = true
    await Motion(r, [x=x, y=y], 300)
    set r.entering = false
}

;; a rabbit jumps over the bad one and comes back: two tweens, chained
task Jump (r, x, y, bx, by) {
    await Motion(r, [x=x, y=y], 400)
    await Motion(r, [x=bx, y=by], 600)
}

;; a rabbit of the last level fades, and then dies
task Fade (r) {
    await Motion(r, [alpha=0], 300)
    sprite_kill(r)
}

task Play () {
    pin phys = Physics_screen()         ;; the bodies of the screen (Physics)
    set :out Physics.scr = phys
    pin rabbits = tasks(30)
    val bbody = Body(do {
        val bad = Sprite(IMG_BAD, W/2, H/2)
        set bad.ax, bad.ay = (0.5, 1)
        sprite_add(bad, :walk, [0, 1], 5, true)
        sprite_play(bad, :walk)
        bad
    }, :bad)
    val bad = bbody.spr
    pin circle = Sprite(IMG_CIRCLE, W/2, H/2)
    set circle.ax, circle.ay = (0.5, 0.5)
    pin start = Text((W/2) + 0.5, 30, "try to save the rabbits by pressing space", 20, 0.5)
    set start.ax, start.ay = (0.5, 0.5)
    pin world = Text(W/2, H/2, "10", 80, 0.5)
    set world.ax, world.ay = (0.5, 0.5)
    set score, level = (65, 0)
    eng.play(SND_MUSIC, 0.4)
    pin tweens = tasks()
    val cw = IMG_CIRCLE.fw          ;; circle.width

    ;; [trace]
    pin trace_q = [ bad=bad, rabbits=rabbits ]
    set :out Trace.q = trace_q              ;; Tracer reads it while the screen lasts
    ;; [/trace]

    spawn {
        loop on :draw {
            ray.clear(BG)
            loop _, t in rabbits {
                sprite_draw(t.pub.s)
            }
            sprite_draw(bad)
            sprite_draw(circle)
            text_draw(start)
            text_draw(world)
        }
    }
    spawn {
        loop on :pre {
            sprite_update(bad)
        }
    }

    ;; draw_level: the rabbits left fade; :end after the last level
    val func draw_level () {
        loop _, t in rabbits {
            if t.pub.s.alive {
                spawn @(t.pub.tw) Fade(t.pub.s)
            }
        }
        set world.s = tostring(9 - level)
        if level == 9 {
            return :end
        }
        if level == 1 {
            spawn @tweens Motion(start, [alpha=0], 500)
        }
        loop i, k in MAP@(level) {
            if k != 0 {
                spawn @rabbits Rabbit(i * (math.pi / 10), i, cw)
            }
        }
        set level += 1
        nil
    }

    ;; jump: SPACE (space_key.onDown, in the event of the key, before the
    ;; frame): the first rabbit of the circle that has not jumped, if it is
    ;; already there
    spawn {
        loop e on :key.dn {
            if e.key == 'SPACE' {
                var min, r, rt = (20, nil, nil)
                loop _, t in rabbits {
                    val x = t.pub.s
                    if x.alive && (x.jump == false) && (x.pos < min) {
                        set min, r, rt = (x.pos, x, t)
                    }
                }
                if (min != 20) && !r.entering {
                    eng.play(SND_VOWELS@(eng.rand(5)), 0.3)
                    val d = (cw / 2) + 90
                    val jx = (W/2) + (d * math.cos(r.rot - (math.pi / 2)))
                    val jy = (H/2) + (d * math.sin(r.rot - (math.pi / 2)))
                    spawn @(rt.pub.tw) Jump(r, jx, jy, r.x, r.y)
                    set r.jump = true
                }
            }
        }
    }

    ;; the update, in the order of the original; `change` is the flag
    ;; change_level: a new level once per turn, when the bad one passes the
    ;; top of the circle
    var change = true
    do :play {
        loop on :update {
            loop _, b in overlap_list(bbody, :rabbit) {
                sprite_kill(b.spr)
                set score -= 1
                eng.play(SND_HAHO, 0.5)
            }
            val a = angle_get(bad)
            ifs {
                (a >= -2) && (a <= 2) && change => {
                    set change = false
                    if draw_level() == :end {
                        escape :play
                    }
                }
                a > 2 => set change = true
            }
            angle_set(bad, angle_get(bad) + 1.2)
            val x = (W/2) + (((cw / 2) - 4) * math.cos(bad.rot - (math.pi / 2)))
            val y = (H/2) + (((cw / 2) - 4) * math.sin(bad.rot - (math.pi / 2)))
            sprite_reset(bad, bbody, x, y)
        }
    }
}

;; [trace]
;; the line of the trace: as tools/original/trace/9.js
func trace (p) {
    val f = ray.frame()
    var r = tostring(f) ++ " " ++ screen ++ " " ++ tostring(score) ++ " " ++
            tostring(level) ++ " " ++ tostring(best_score)
    if screen == "Play" {
        var n, sx, sy, sa = (0, 0, 0, 0)
        loop _, t in p.rabbits {
            val x = t.pub.s
            if x.alive {
                set n += 1
                set sx += x.x
                set sy += x.y
                set sa += x.alpha
            }
        }
        set r = r ++ " " ++ eng.fixed(angle_get(p.bad), 2) ++ " " ++ tostring(n) ++ " " ++
                eng.fixed(sx, 2) ++ " " ++ eng.fixed(sy, 2) ++ " " ++ eng.fixed(sa, 3)
    }
    r
}
;; [/trace]
