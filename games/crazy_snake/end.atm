;; End: the score and the best score; UP starts again, after 500 ms.

task End () {
    pin ctx = Screen()
    spawn Screen_run(ctx)
    input_reset()
    if score > best_score {
        set best_score = score
    }
    pin l1 = Text(W/2, (H/2) - 100, "You Died", 60, 0.5)
    pin l2 = Text(W/2, H - 220, "score: " ++ tostring(score) ++ "\nbest score: " ++ tostring(best_score), 25, 0.5)
    pin l3 = Text(W/2, H - 120, "press up arrow key to restart", 25, 0.5)
    loop _, t in [l1, l2, l3] {
        set t.ax, t.ay = (0.5, 0.5)
    }
    set l1.sx, l1.sy = (0, 0)
    spawn Motion(ctx, l1, [sx=1, sy=1], 1000, Ease.bounce_out)
    set l2.alpha, l3.alpha = (0, 0)
    spawn Motion(ctx, l2, [alpha=1], 500, nil, 500)
    spawn Motion(ctx, l3, [alpha=1], 500, nil, 500)
    spawn Swing(ctx, l3, H - 100, H - 75)
    spawn {
        loop on :rl.draw {
            rl.clear(0x000000FF)
            text_draw(l1)
            text_draw(l2)
            text_draw(l3)
        }
    }
    val time = eng.now() + 500
    await :update until key_down('UP') && (time < eng.now())
    await :state                    ;; state.start('Play'), in the next frame
}
