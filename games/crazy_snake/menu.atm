;; Menu: the title, and UP to start.

pin IMG_SOUND = eng.image(A ++ "images/sound.png", 28, 22)

;; a button: pressed and released over it (the box of its frame)
func over (s, x, y) {
    val w, h = (s.img.fw * s.sx, s.img.fh * s.sy)
    val l, t = (s.x - (s.ax * w), s.y - (s.ay * h))
    (x >= l) && (x <= (l + w)) && (y >= t) && (y <= (t + h))
}
task Button (s) {
    loop {
        val d = await :rl.mouse.dn
        if over(s, d.x, d.y) {
            val u = await :rl.mouse.up
            until over(s, u.x, u.y)
        }
    }
}

;; a text that goes down and up, for ever: .to(a).to(b).loop()
task Swing (ctx, t, a, b) {
    loop {
        await Motion(ctx, t, [y=a], 500)
        await Motion(ctx, t, [y=b], 500)
    }
}

task Menu () {
    pin ctx = Screen()
    spawn Screen_run(ctx)
    input_reset()
    pin title = Text(W/2, (H/2) - 100, "Crazy Snake", 60, 0.5)
    pin start = Text(W/2, H - 150, "press the UP arrow key to start", 25)
    loop _, t in [title, start] {
        set t.ax, t.ay, t.color = (0.5, 0.5, INK)
    }
    set title.sx, title.sy = (0, 0)
    spawn Motion(ctx, title, [sx=1, sy=1], 1000, Ease.bounce_out)
    set start.alpha = 0
    spawn Motion(ctx, start, [alpha=1], 500, nil, 500)
    spawn Swing(ctx, start, H - 150, H - 125)
    pin snd_btn = Sprite(IMG_SOUND, W - 50, 50)
    set snd_btn.ax, snd_btn.ay = (1, 0)
    set snd_btn.alpha = 0
    spawn Motion(ctx, snd_btn, [alpha=1], 500, nil, 500)
    spawn {
        loop {
            await Button(snd_btn)
            set snd_btn.frame = if snd_btn.frame == 0 => 1 => 0
            set sound = snd_btn.frame == 0
        }
    }
    spawn {
        loop on :rl.draw {
            rl.clear(0xFFFFFFFF)
            text_draw(title)
            text_draw(start)
            sprite_draw(snd_btn)
        }
    }
    await :update until key_down('UP')
    await :state                    ;; state.start('Play'), in the next frame
}
