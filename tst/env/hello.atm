;; The environment builds and runs with no screen: a window of the size of
;; Run!, its background, a text, and a second.

include "../../env/ray.atm"

ray.window [title="hello", width=350, height=350]

spawn {
    await 1s
    print(ray.frame(), "1s")
}
spawn {
    loop on :draw {
        ray.clear(0x34495EFF)
        ray.text("hello", 15, 10, 20, ray.WHITE)
    }
}
await :quit
print(ray.frame(), "quit")
