;; Game: a frame of Phaser 1.1.3 (Game.update), over the events of
;; env/ray.atm, so that a port does in each frame what its original did,
;; in the same order:
;;
;;      (tweens_pass)   tweens.update: the tweens of Motion move
;;      :pre            world.update: each sprite updates its animation and
;;                      tests if it left the world; then the bodies move
;;                      (physics_pre)
;;      :particles      particles.update: the emitters emit
;;      :update         state.update: the game
;;      :overlap        the end of state.update, where the games call
;;                      physics.overlap and physics.collide
;;      (physics_post)  world.postUpdate: the sprites follow their bodies
;;      :draw        render
;;
;; The game awaits :pre and :update, not :frame. `await Wait(ms)` is a
;; comparison with the clock of Phaser, in :update, as
;; `if (game.time.now > this.time)` was in an update.

include "engine.atm"
include "motion.atm"
include "sprite.atm"
include "physics.atm"
include "particles.atm"
include "input.atm"
include "scene.atm"
include "arcade116.atm"
include "arcade201.atm"

;; Phaser 1.1.3, when it boots, seeds game.rnd with one draw of Math.random:
;; new Phaser.RandomDataGenerator([(Date.now() * Math.random()).toString()]),
;; with the clock of the harness at 1000
eng.rnd_sow(eng.tostring(1000 * eng.random()))

;; Keys: the frame of the last press of each key (an :key.dn before
;; frame f is a keydown before the update of frame f)
pin Keys = [ frame = 0, pressed = [] ]

;; Cursor(): the keys of a state, as game.input.keyboard.createCursorKeys():
;; new keys, which are up until pressed after they were created. A key held
;; from the previous state is not down in the next one until pressed again.
;;
;;      val keys = Cursor()
;;      if cursor_down(keys, 'UP') { ... }
func Cursor () {
    :Cursor [ born = Keys.frame ]
}

func cursor_down (c, k) {
    ray.key_down(k) && ((Keys.pressed@k || -1) > c.born)
}

;; input.reset, which Phaser 1.1.3 does when a state starts (World.destroy):
;; all keys up, the pointer up, the camera at 0. A key or a button held from
;; the state before counts again only once pressed again. A screen of a port
;; calls input_reset() when it starts, as a state does.
pin Input = [ reset = -1, mouse = -1 ]

func input_reset () {
    set Input.reset = Keys.frame
    set Camera.x, Camera.y = (0, 0)
}

;; game.input.keyboard.isDown(k), since the last reset
func key_down (k) {
    ray.key_down(k) && ((Keys.pressed@k || -1) > Input.reset)
}

;; game.input.activePointer.isDown, since the last reset
func pointer_down () {
    ray.mouse_down(0) && (Input.mouse > Input.reset)
}

task Wait (ms) {
    val t = eng.now() + ms
    await :update until eng.now() > t
}

;; Every(ms, f): game.time.events.loop(ms, f) of Phaser 2.0.2 (Timer), on
;; :time: the first call at now + ms (Timer.create, with the time of the
;; frame in which it is created), then each call at the time it was due
;; plus ms, less the delay, as Timer.update computes it
task Every (ms, f) {
    var tick = ms + eng.now()
    loop on :time {
        val now = eng.now()
        if now >= tick {
            val late = now - tick
            set tick = (now + ms) - late
            if tick < 0 {
                set tick = now + ms
            }
            f()
        }
    }
}

;; Game(w, h, [ver]): with ver 2, a frame of Phaser 2.0.2 (Game.update):
;;
;;      :time           time.update: the timers (Every)
;;      :state          state.preUpdate: a state started in the frame before
;;                      begins here (the screen that ends awaits :state)
;;      :pre            stage.preUpdate: the sprites and their bodies
;;                      (scene_pre)
;;      (tweens_pass)   tweens.update
;;      :update         state.update
;;      :post           stage.postUpdate: the camera, the bodies move their
;;                      sprites (scene_post201)
;;      :render         the render: the transforms (scene_transform)
;;
;; With ver 116, a frame of Phaser 1.1.6: :pre (world.preUpdate: the
;; sprites and their bodies, lib/arcade116.atm), the tweens, :update
;; (state.update), :post (world.postUpdate: the target of the camera, the
;; camera, the other sprites), :render (the transforms drawn).
;;
;; The tweens that a state starts in its create move from the next frame
;; (they are added at the end of the pass of the same frame): for the state
;; created before frame 1, Game adds them before the pass of frame 1.
task Game (w, h, ver) {
    set Physics.x, Physics.y = (0, 0)
    set Physics.w = w
    set Physics.h = h
    set Camera.w, Camera.h = (w, h)
    spawn {
        loop e on :key.dn {
            set Keys.pressed@(e.code) = Keys.frame + 1          ;; by code
            if e.key {
                set Keys.pressed@(e.key) = Keys.frame + 1       ;; and by name
            }
        }
    }
    spawn {
        loop e on :mouse.button.dn {
            if e.button == 0 {
                set Input.mouse = Keys.frame + 1
            }
        }
    }
    spawn Input_run()
    var prev = eng.now()
    loop on :frame {
        set Keys.frame += 1
        eng.tick()
        eng.update_music()
        val now = eng.now()
        set Physics.elapsed = now - prev
        set Physics.dt = Physics.elapsed / 1000
        set prev = now
        if ver == 116 {
            if Physics.dt > 0.05 {
                set Physics.dt = 0.05               ;; Time.update clamps it
            }
            emit @:global :pre                      ;; world.preUpdate (body6_pre)
            tweens_pass()
            emit @:global :update                   ;; state.update
            emit @:global :post                     ;; world.postUpdate, camera
            emit @:global :render                   ;; the transforms drawn
            skip
        }
        if ver == 2 {
            emit @:global :time
            emit @:global :state
            emit @:global :pre
            if Keys.frame == 1 {
                loop _, r in Tweens.add {
                    set Tweens.list@+ = r
                }
                vector.clear(Tweens.add)
            }
            tweens_pass()
            emit @:global :update
            emit @:global :post                     ;; stage.postUpdate
            emit @:global :render
            skip
        }
        tweens_pass()
        emit @:global :pre
        physics_pre()
        emit @:global :particles
        emit @:global :update
        emit @:global :overlap
        physics_post()
        physics_draw()
    }
}

;; [trace]
;; Tracer(f): in test mode (RL_FRAMES), a line per frame, after the frame:
;; f(Trace.q). A screen whose line needs what it owns gives it in Trace.q,
;; which refers to it while the screen lasts (nil otherwise):
;;
;;      pin trace_q = [ player=player, score=\{ score } ]
;;      set :out Trace.q = trace_q
pin Trace = [ q = nil ]

task Tracer (f) {
    if os.getenv("RL_FRAMES") {
        loop on :frame {
            print(f(Trace.q))
        }
    }
}
;; [/trace]
