;; Arcade201: the arcade physics of Phaser 2.0.1, which The Three Hearts
;; uses, read from the phaser201.min.js that the original runs (it differs
;; from the source of the tag 2.0.1 in ext/phaser/: it is nearer 2.0.2),
;; over the display tree of lib/scene.atm.
;;
;;      body201(s)                              ;; physics.arcade.enable(s)
;;      scene_pre201(g)                         ;; in :pre (stage.preUpdate)
;;      scene_post201(g)                        ;; in :post (stage.postUpdate)
;;      collide201(a, group, f)                 ;; physics.arcade.collide
;;      overlap201(a, group, f)                 ;; physics.arcade.overlap
;;      tiles201_collide(m, a)                  ;; collide(sprite, layer)
;;
;; A body is read in preUpdate from the transform of the last render (prev
;; is that position), moved by its velocity, and in postUpdate the sprite
;; moves by the delta of its body. Its size is that of the sprite when it was
;; enabled: a scale of the sprite later does not change it.

;; physics.arcade.enable: a body of the size of the frame
func body201 (s) {
    set s.body = [
        sw = s.img.fw, sh = s.img.fh,           ;; sourceWidth, sourceHeight
        w = s.img.fw * s.sx, h = s.img.fh * s.sy,
        asx = s.sx, asy = s.sy,                 ;; _sx, _sy
        x = s.x, y = s.y, px = s.x, py = s.y,   ;; position, prev
        vx = 0, vy = 0,
        immovable = false, moves = true,
        touching = [ up=false, down=false, left=false, right=false ],
        blocked = [ up=false, down=false, left=false, right=false ],
    ]
    s.body
}

;; Sprite.reset(x, y) and Body.reset(x, y): the body at (x, y) itself, not
;; moved by the anchor, until the next preUpdate
func sprite_reset201 (s, x, y) {
    set s.x, s.y = (x, y)
    set s.alive, s.exists, s.visible = (true, true, true)
    val b = s.body
    if b {
        set b.vx, b.vy = (0, 0)
        set b.x, b.y = (x, y)
        set b.px, b.py = (x, y)
    }
}

;; Body.preUpdate
func body201_pre (s, wx, wy, fresh) {
    val b = s.body
    set b.touching.up, b.touching.down, b.touching.left, b.touching.right = (false, false, false, false)
    set b.blocked.up, b.blocked.down, b.blocked.left, b.blocked.right = (false, false, false, false)
    set b.x = wx - (s.ax * b.w)
    set b.y = wy - (s.ay * b.h)
    set b.px, b.py = (b.x, b.y)
    if b.moves {
        ;; updateMotion: no gravity, acceleration or drag here; the
        ;; velocity is only kept within 10000
        set b.x += b.vx * Physics.dt
        set b.y += b.vy * Physics.dt
    }
}

;; stage.preUpdate for a group of the tree (lib/scene.atm): each child, from
;; the last (Group.preUpdate goes backwards); a sprite reads its position
;; in the world, from its parent when it is fresh, else from the transform
;; drawn; its animation, then its body
func scene_pre201 (g) {
    var i = #g.kids
    loop {
        while i > 0
        set i -= 1
        val k = g.kids@i
        ifs {
            k ?? :Group2 => scene_pre201(k)
            (k ?? :Sprite) && k.fresh => {
                val wx, wy = (g.x + k.x, g.y + k.y)
                set k.wt.tx, k.wt.ty = (wx, wy)
                set k.fresh = false
                if k.body && (k.exists != false) {
                    body201_pre(k, wx, wy, true)
                }
            }
            (k ?? :Sprite) && (k.exists != false) => {
                sprite_update(k)
                if k.body {
                    body201_pre(k, Camera.x + k.wt.tx, Camera.y + k.wt.ty, false)
                }
            }
            else => nil
        }
    }
}

;; Body.postUpdate: the sprite moves by the delta of its body
func body201_post (s) {
    val b = s.body
    if b.moves {
        set s.x += b.x - b.px
        set s.y += b.y - b.py
    }
}

;; stage.postUpdate for a group: each child that exists, from the last
func scene_post201 (g) {
    var i = #g.kids
    loop {
        while i > 0
        set i -= 1
        val k = g.kids@i
        ifs {
            k ?? :Group2 => scene_post201(k)
            (k ?? :Sprite) && (k.exists != false) && k.body => body201_post(k)
            else => nil
        }
    }
}

;; Rectangle.intersects of two bodies (edges included)
func body201_meet (a, b) {
    (a.w > 0) && (a.h > 0) && (b.w > 0) && (b.h > 0) &&
        !(((a.x + a.w) < b.x) || ((a.y + a.h) < b.y) || (a.x > (b.x + b.w)) || (a.y > (b.y + b.h)))
}

;; separateY and separateX, for a body that moves and one that may be
;; immovable (OVERLAP_BIAS 4); true if they were separated
func separate201_y (b1, b2) {
    if b1.immovable && b2.immovable {
        return false
    }
    if !body201_meet(b1, b2) {
        return false
    }
    val d1, d2 = (b1.y - b1.py, b2.y - b2.py)
    val mx = (math.abs(d1) + math.abs(d2)) + 4
    var o = 0
    ifs {
        (d1 == 0) && (d2 == 0) => nil           ;; embedded
        d1 > d2 => {
            set o = (b1.y + b1.h) - b2.y
            if o > mx {
                set o = 0
            } else {
                set b1.touching.down, b2.touching.up = (true, true)
            }
        }
        d1 < d2 => {
            set o = b1.y - (b2.y + b2.h)
            if (-o) > mx {
                set o = 0
            } else {
                set b1.touching.up, b2.touching.down = (true, true)
            }
        }
    }
    if o == 0 {
        return false
    }
    val v1, v2 = (b1.vy, b2.vy)
    ifs {
        !b1.immovable && !b2.immovable => {
            ;; two bodies that move: not in this game
            set o *= 0.5
            set b1.y = b1.y - o
            set b2.y += o
        }
        !b1.immovable => {
            set b1.y = b1.y - o
            set b1.vy = v2 - (v1 * 0)             ;; bounce 0
            if b2.moves {
                set b1.x += b2.x - b2.px
            }
        }
        else => {
            set b2.y += o
            set b2.vy = v1 - (v2 * 0)
            if b1.moves {
                set b2.x += b1.x - b1.px
            }
        }
    }
    true
}
func separate201_x (b1, b2) {
    if b1.immovable && b2.immovable {
        return false
    }
    if !body201_meet(b1, b2) {
        return false
    }
    val d1, d2 = (b1.x - b1.px, b2.x - b2.px)
    val mx = (math.abs(d1) + math.abs(d2)) + 4
    var o = 0
    ifs {
        (d1 == 0) && (d2 == 0) => nil
        d1 > d2 => {
            set o = (b1.x + b1.w) - b2.x
            if o > mx {
                set o = 0
            } else {
                set b1.touching.right, b2.touching.left = (true, true)
            }
        }
        d1 < d2 => {
            set o = (b1.x - b2.w) - b2.x
            if (-o) > mx {
                set o = 0
            } else {
                set b1.touching.left, b2.touching.right = (true, true)
            }
        }
    }
    if o == 0 {
        return false
    }
    val v1, v2 = (b1.vx, b2.vx)
    ifs {
        !b1.immovable && !b2.immovable => {
            set o *= 0.5
            set b1.x = b1.x - o
            set b2.x += o
        }
        !b1.immovable => {
            set b1.x = b1.x - o
            set b1.vx = v2 - (v1 * 0)
        }
        else => {
            set b2.x += o
            set b2.vx = v1 - (v2 * 0)
        }
    }
    true
}

;; collideSpriteVsGroup and overlap: a quadtree of the world with the
;; bodies of the group that exist (in the order of the group), then each one
;; that it gives for the body of `a`; separate (separateX, else
;; separateY), or only test the overlap; f(other sprite) for each
func group201 (a, group, f, only) {
    pin q = qt_node(Physics.x, Physics.y, Physics.w, Physics.h, 0)
    loop _, k in group.kids {
        if k.body && (k.exists != false) {
            qt_insert(q, k.body)
        }
    }
    pin found = []
    qt_retrieve(q, a.body, found)
    loop _, b in found {
        val hit = if only => body201_meet(a.body, b) => body201_meet(a.body, b) && (separate201_x(a.body, b) || separate201_y(a.body, b))
        if hit {
            f(group201_sprite(group, b))
        }
    }
}
func collide201 (a, group, f) { group201(a, group, f, false) }
func overlap201 (a, group, f) { group201(a, group, f, true) }

;; the sprite of a body, in its group
func group201_sprite (group, b) {
    var s = nil
    loop _, k in group.kids {
        if k.body == b {
            set s = k
        }
    }
    s
}

;; A tilemap of Phaser 2.0.1: the indices, row by row (0 is no tile), the
;; tiles that collide (setCollisionBetween), and their faces
;; (calculateFaces: a face against a tile that collides does not count)
func Tilemap201 (data, w, h, tw, th) {
    :Tilemap201 [ data=data, w=w, h=h, tw=tw, th=th, collides=[], faces=[] ]
}

func map201_at (m, x, y) {
    if (x >= 0) && (x < m.w) && (y >= 0) && (y < m.h) => m.data@((y * m.w) + x) => 0
}

func map201_collides (m, x, y) {
    val t = map201_at(m, x, y)
    (t != 0) && (m.collides@t == true)
}

func map201_collision (m, a, b) {
    var i = a
    loop {
        while i <= b
        set m.collides@i = true
        set i += 1
    }
    loop y in m.h {
        loop x in m.w {
            if map201_collides(m, x, y) {
                set m.faces@((y * m.w) + x) = [
                    top    = !map201_collides(m, x, y - 1),
                    bottom = !map201_collides(m, x, y + 1),
                    left   = !map201_collides(m, x - 1, y),
                    right  = !map201_collides(m, x + 1, y),
                ]
            }
        }
    }
}

;; Tile.intersects (edges excluded)
func tile201_meet (b, t) {
    !(((b.x + b.w) <= t.x) || ((b.y + b.h) <= t.y) || (b.x >= (t.x + t.w)) || (b.y >= (t.y + t.h)))
}

;; tileCheckX and tileCheckY (TILE_BIAS 16), with processTileSeparation:
;; the body is pushed out, blocked on that side, stopped (bounce 0)
func tile201_x (b, t, f) {
    val d = b.x - b.px
    var ox = 0
    ifs {
        (d < 0) && !b.blocked.left => {
            if f.right && (b.x < (t.x + t.w)) {
                set ox = b.x - (t.x + t.w)
                if ox < -16 { set ox = 0 }
            }
        }
        (d > 0) && !b.blocked.right => {
            if f.left && ((b.x + b.w) > t.x) {
                set ox = (b.x + b.w) - t.x
                if ox > 16 { set ox = 0 }
            }
        }
    }
    if ox != 0 {
        if ox < 0 { set b.blocked.left = true } else { set b.blocked.right = true }
        set b.x -= ox
        set b.vx = 0
    }
    ox
}
func tile201_y (b, t, f) {
    val d = b.y - b.py
    var oy = 0
    ifs {
        (d < 0) && !b.blocked.up => {
            if f.bottom && (b.y < (t.y + t.h)) {
                set oy = b.y - (t.y + t.h)
                if oy < -16 { set oy = 0 }
            }
        }
        (d > 0) && !b.blocked.down => {
            if f.top && ((b.y + b.h) > t.y) {
                set oy = (b.y + b.h) - t.y
                if oy > 16 { set oy = 0 }
            }
        }
    }
    if oy != 0 {
        if oy < 0 { set b.blocked.up = true } else { set b.blocked.down = true }
        set b.y -= oy
        set b.vy = 0
    }
    oy
}

;; separateTile: the axis of the larger delta first (or, moving on both
;; axes against a corner, the axis of the smaller overlap)
func tile201_separate (b, t, f) {
    if !tile201_meet(b, t) {
        return false
    }
    if !f.left && !f.right && !f.top && !f.bottom {
        return false
    }
    val dx, dy = (b.x - b.px, b.y - b.py)
    var mnx, mny = (0, 1)
    ifs {
        math.abs(dx) > math.abs(dy) => set mnx = -1
        math.abs(dx) < math.abs(dy) => set mny = -1
    }
    if (dx != 0) && (dy != 0) && (f.left || f.right) && (f.top || f.bottom) {
        set mnx = math.min(math.abs(b.x - (t.x + t.w)), math.abs((b.x + b.w) - t.x))
        set mny = math.min(math.abs(b.y - (t.y + t.h)), math.abs((b.y + b.h) - t.y))
    }
    var ox, oy = (0, 0)
    if mnx < mny {
        if f.left || f.right {
            set ox = tile201_x(b, t, f)
            if (ox != 0) && !tile201_meet(b, t) {
                return true
            }
        }
        if f.top || f.bottom {
            set oy = tile201_y(b, t, f)
        }
    } else {
        if f.top || f.bottom {
            set oy = tile201_y(b, t, f)
            if (oy != 0) && !tile201_meet(b, t) {
                return true
            }
        }
        if f.left || f.right {
            set ox = tile201_x(b, t, f)
        }
    }
    (ox != 0) || (oy != 0)
}

;; collideSpriteVsTilemapLayer: all the tiles under the body (getTiles,
;; a tile more each way), in order, row by row
func tiles201_collide (m, s) {
    val b = s.body
    val x = math.max(0, b.x)
    val y = math.max(0, b.y)
    val w = math.min(b.w, m.w * m.tw)
    val h = math.min(b.h, m.h * m.th)
    val tx = (m.tw * math.floor(x / m.tw)) / m.tw
    val ty = (m.th * math.floor(y / m.th)) / m.th
    val tw = ((m.tw * math.ceil(w / m.tw)) + m.tw) / m.tw
    val th = ((m.th * math.ceil(h / m.th)) + m.th) / m.th
    var wy = ty
    loop {
        while wy < (ty + th)
        var wx = tx
        loop {
            while wx < (tx + tw)
            if (wy < m.h) && (wx < m.w) && (map201_at(m, wx, wy) != 0) {
                val f = m.faces@((wy * m.w) + wx) || NO_FACES
                tile201_separate(b, [ x=wx * m.tw, y=wy * m.th, w=m.tw, h=m.th ], f)
            }
            set wx += 1
        }
        set wy += 1
    }
}
